# Local port map — avoids clashes with VPN (8080 proxy, 172.x Docker vs tun0 routes).
# Copy to .env and adjust if a port is still taken: cp .env.example .env

# Bind published ports to localhost only (recommended with VPN active)
COMPOSE_BIND=127.0.0.1

# Host ports (left side of docker port mapping)
POSTGRES_HOST_PORT=5455
REDIS_HOST_PORT=16379
ZOOKEEPER_HOST_PORT=12181
KAFKA_HOST_PORT=19092
KAFKA_EXTERNAL_HOST_PORT=19093
MOCK_IDENTITY_HOST_PORT=8082
ESIGNET_HOST_PORT=8088
OIDC_UI_HOST_PORT=3000
ARTIFACTORY_HOST_PORT=18080

# Python artifactory used by run-local.sh (keep in sync with ARTIFACTORY_HOST_PORT)
ARTIFACTORY_PORT=18080

# Docker bridge subnet outside common VPN split-tunnel ranges (10/8, 172.16/12, 192.168/16)
DOCKER_SUBNET=198.18.50.0/24
OIDC_UI_NETWORK=verifayda-local
DOCKER_COMPOSE_SUBNET=198.18.51.0/24
